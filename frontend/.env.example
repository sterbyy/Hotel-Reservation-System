# Leave empty to use the Vite dev proxy (recommended for local work).
# Set an absolute origin when the frontend is served separately from the backend,
# for example VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
# Backend origin the dev proxy forwards /api and /health to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
